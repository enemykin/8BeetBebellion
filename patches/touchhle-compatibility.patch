+    for key in [
+        GameKey::D,
+        GameKey::Right,
+        GameKey::A,
+        GameKey::Left,
+        GameKey::Space,
+    ] {
+        let mut keys = HashSet::from([key]);
+        let mut direction = keyboard_horizontal_direction(&keys);
+        let mut queue = VecDeque::from([
+            Event::TouchesDown(HashMap::from([(
+                FingerId::KeyboardDirection,
+                (135.0, 290.0),
