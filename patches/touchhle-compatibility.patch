+fn access_result(
+    (exists, read, write, execute): (bool, bool, bool, bool),
+    mode: i32,
+) -> Result<(), i32> {
+    if mode == F_OK {
+        return if exists { Ok(()) } else { Err(ENOENT) };
+    }
+    if mode & !(R_OK | W_OK | X_OK) != 0 {
+        return Err(EINVAL);
+    }
+    if !exists {
+        return Err(ENOENT);
+    }
+    if mode & W_OK != 0 && !write {
+        return Err(EROFS);
+    }
+    if (mode & R_OK != 0 && !read) || (mode & X_OK != 0 && !execute) {
+        return Err(EACCES);
+    }
