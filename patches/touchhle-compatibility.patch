+/// resizing its pixels or changing the guest's view geometry.
+fn landscape_launch_image_geometry(
+    bounds: CGRect,
+    position: CGPoint,
+    anchor: CGPoint,
+    transform: CGAffineTransform,
+    portrait_size: (u32, u32),
