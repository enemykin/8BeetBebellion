+    use crate::frameworks::core_graphics::CGPoint;
+    use crate::objc::id;
+
+    if env.bundle.bundle_identifier() != "com.alife.linkinpark"
+        || env.bundle.bundle_version() != "1.4.5"
+    {
+        return;
+    }
+    let Some(class) = env
+        .objc
+        .all_classes()
+        .find(|(name, _)| name.as_str() == "DoorEntryComponent")
+        .map(|(_, &class)| class)
+    else {
